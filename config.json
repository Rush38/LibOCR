{
  "paths": {
    "input_dir": "input_files",
    "output_dir": "output_texts",
    "log_dir": "logs",
    "debug_dir": "debug",
    "error_reports_dir": "error_reports"
  },
  "ocr": {
    "easyocr": {
      "enabled": true,
      "languages": ["ru", "en"],
      "gpu": true,
      "confidence_threshold": 0.3,
      "paragraph": true
    },
    "tesseract": {
      "enabled": true,
      "path": "C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
      "languages": "rus+eng",
      "oem": 3,
      "psm": 6,
      "dpi": 300,
      "adaptive_psm": true
    },
    "trocr": {
      "enabled": true,
      "model_name": "Kansallisarkisto/cyrillic-large-handwritten",
      "device": "auto",
      "stride": 128,
      "local_models_dir": "models",
      "line_segmentation": true
    },
    "glmocr": {
      "enabled": false,
      "model_name": "zai-org/GLM-OCR",
      "device": "auto",
      "local_models_dir": "models",
      "note": "model incompatible with transformers pipeline, requires manual setup"
    }
  },
  "pdf": {
    "enabled": true,
    "dpi": 300,
    "first_page_only": false,
    "max_pages": 50,
    "color_conversion": "RGB",
    "auto_rotate": true
  },
  "preprocessing": {
    "clahe": {
      "clip_limit": 2.0,
      "tile_grid_size": [8, 8]
    },
    "line_removal": {
      "h_thresh": 0.4,
      "v_thresh": 0.3
    },
    "stamp_suppression": {
      "hsv_ranges": [
        {"h": [100, 140], "s": [20, 255], "v": [20, 255]},
        {"h": [140, 170], "s": [20, 255], "v": [20, 255]}
      ],
      "sat_reduction": 0.0
    },
    "angle_correction": {
      "max_deviation": 45.0
    },
    "cache": {
      "enabled": true,
      "maxsize": 100
    },
    "stamp_detection": {
      "enabled": true,
      "min_area": 400
    }
  },
  "processing": {
    "max_workers": 2,
    "timeout_engine": 60,
    "timeout_image": 180,
    "retry": 3,
    "retry_delay": 2
  },
  "output": {
    "encoding": "utf-8-sig",
    "csv_sep": ";",
    "max_log_mb": 10,
    "log_backups": 5
  }
}
