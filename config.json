{
  "paths": {
    "input_dir": "input_files",
    "output_dir": "output_texts",
    "log_dir": "logs",
    "debug_dir": "debug",
    "error_reports_dir": "error_reports"
  },
  "ocr": {
    "easyocr": {
      "enabled": true,
      "languages": ["ru", "en"],
      "gpu": true,
      "confidence_threshold": 0.3,
      "paragraph": true
    },
    "tesseract": {
      "enabled": true,
      "path": "C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
      "languages": "rus+eng",
      "oem": 3,
      "psm": 6,
      "dpi": 300,
      "adaptive_psm": true,
      "old_russian": true
    },
    "trocr": {
      "enabled": true,
      "model_name": "Kansallisarkisto/cyrillic-large-handwritten",
      "device": "auto",
      "stride": 128,
      "local_models_dir": "models",
      "line_segmentation": true
    },
    "glmocr": {
      "enabled": false,
      "model_name": "zai-org/GLM-OCR",
      "device": "auto",
      "local_models_dir": "models",
      "note": "experimental"
    },
    "doctr": {
      "enabled": true,
      "languages": ["ru", "en"],
      "gpu": true
    },
    "gotocr": {
      "enabled": true,
      "gpu": true
    }
  },
  "pdf": {
    "enabled": true,
    "dpi": 300,
    "first_page_only": false,
    "max_pages": 50,
    "color_conversion": "RGB",
    "auto_rotate": true
  },
  "preprocessing": {
    "profile": "auto",
    "profiles": {
      "default": { "clahe": { "clip_limit": 2.0, "tile_grid_size": [8, 8] }, "denoise": true },
      "old_document": { "binarize": "sauvola", "window_size": 41, "k": 0.25, "denoise": false },
      "photo": { "denoise": "heavy", "clahe": { "clip_limit": 3.0, "tile_grid_size": [4, 4] } }
    },
    "clahe": {
      "clip_limit": 2.0,
      "tile_grid_size": [8, 8]
    },
    "line_removal": {
      "h_thresh": 0.4,
      "v_thresh": 0.3
    },
    "angle_correction": {
      "max_deviation": 45.0
    },
    "cache": {
      "enabled": true,
      "maxsize": 100
    }
  },
  "processing": {
    "max_workers": 2,
    "timeout_engine": 60,
    "timeout_image": 180,
    "retry": 3,
    "retry_delay": 2,
    "cascade": false
  },
  "output": {
    "encoding": "utf-8-sig",
    "csv_sep": ";",
    "max_log_mb": 10,
    "log_backups": 5,
    "format": "txt",
    "mode": "library",
    "lang": "ru"
  }
}
